# ---------------------------------------------------------------------------
# Data and model weights -- never committed (nuScenes is multi-GB, weights ~65 MB)
# ---------------------------------------------------------------------------
v1.0-mini/
v1.0-trainval/
v1.0-test/
# Anchored on purpose. A bare `dir/` pattern matches at ANY depth, so an unanchored
# `data/` once silently excluded the `src/bevision/data/` source package and the repo
# shipped without it. Dataset and build/environment directories only ever live at the
# repository root, so they are anchored there and can never swallow a source package.
/samples/
/sweeps/
/maps/
*.pth
*.pt
*.bin
*.tgz
*.zip
/data/
/datasets/
/checkpoints/
# Cloned into the repository root by scripts/install_mmdet3d.sh and by the docs/SETUP.md
# instructions. It is a dependency checkout, not source, so it stays out of the repository.
/mmdetection3d/

# ---------------------------------------------------------------------------
# Evaluation artifacts. The metric JSONs ARE committed -- they are the evidence
# behind every number in the README. Rendered curve images are regenerable from
# metrics_details.json, so they stay out.
# ---------------------------------------------------------------------------
results/*/plots/
results/*/*.pdf
results/*/*.png

# ---------------------------------------------------------------------------
# Python / notebooks
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.so
*.egg-info/
/build/
/dist/
/.eggs/
.ipynb_checkpoints/
.venv/
/venv/
/env/

# ---------------------------------------------------------------------------
# Tooling / OS
# ---------------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
/htmlcov/
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
.env
*.local
kaggle.json
